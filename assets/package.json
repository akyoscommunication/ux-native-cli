{
    "name": "@akyos/ux-native-cli",
    "description": "Stimulus controllers for the Hotwire Native bridges of akyos/ux-native-cli",
    "license": "MIT",
    "type": "module",
    "symfony": {
        "controllers": {
            "notification-token": {
                "main": "controllers/notification_token_controller.js",
                "name": "bridge--notification-token",
                "fetch": "eager",
                "enabled": true
            },
            "barcode-scanner": {
                "main": "controllers/barcode_scanner_controller.js",
                "name": "bridge--barcode-scanner",
                "fetch": "eager",
                "enabled": true
            },
            "admob": {
                "main": "controllers/admob_controller.js",
                "name": "bridge--admob",
                "fetch": "eager",
                "enabled": true
            },
            "calendar": {
                "main": "controllers/calendar_controller.js",
                "name": "bridge--calendar",
                "fetch": "eager",
                "enabled": true
            },
            "game": {
                "main": "controllers/game_controller.js",
                "name": "bridge--game",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/hotwire-native-bridge": "^1.2.0"
        }
    },
    "peerDependencies": {
        "@hotwired/hotwire-native-bridge": "^1.2.0"
    }
}
